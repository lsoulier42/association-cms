{% extends 'base.html.twig' %}

{% block title %}Actualités LinkedIn | ANDDE{% endblock %}

{% block main_content %}
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="h2 fw-bold text-accent mb-3">Actualités de l'Association</h1>
            <p class="text-muted">Retrouvez nos dernières publications et actualités directement depuis LinkedIn.</p>
            <hr class="w-25 mx-auto mb-5">
        </div>
    </div>

    {% if posts is empty %}
        <div class="alert alert-info text-center py-4 rounded-4 border-0 bg-light">
            <i class="fa fa-info-circle mb-2 fs-3 text-muted"></i>
            <p class="mb-0 text-muted">Aucune actualité n'est disponible pour le moment.</p>
        </div>
    {% else %}
        <div class="row g-4 justify-content-center">
            {% for post in posts %}
                <div class="col-md-8 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        <div class="card-body p-0">
                            {# Display the LinkedIn post via iframe #}
                            <iframe src="{{ post.embedLink }}" 
                                    height="400" 
                                    width="100%" 
                                    frameborder="0" 
                                    allowfullscreen="" 
                                    title="{{ post.title }}"
                                    class="d-block">
                            </iframe>
                        </div>
                        <div class="card-footer bg-white border-top-0 p-3">
                            <h3 class="h6 mb-0 text-truncate" title="{{ post.title }}">{{ post.title }}</h3>
                            <small class="text-muted">Publié le {{ post.createdAt|date('d/m/Y') }}</small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <style>
        .text-accent { color: var(--color-accent); }
    </style>
{% endblock %}
