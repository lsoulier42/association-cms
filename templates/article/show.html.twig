{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block main_content %}
    <h1>{{ article.title }}</h1>
    <p class="text-muted">
        {{ article.publishedAt|date('d/m/Y') }} · {{ article.category.name }}
    </p>
    <div>
        {{ article.content|raw }}
    </div>
{% endblock %}
