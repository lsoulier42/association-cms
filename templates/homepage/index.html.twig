{% extends 'base.html.twig' %}

{% block title %}{{ site_name }}{% endblock %}

{% block main_content %}
    <section class="logo-section mb-5">
        <div class="logo-container text-center">
            <img src="{{ asset('images/logo.svg') }}" alt="{{ site_name }}" width="140" height="140" class="mb-3">
            <p class="lead text-uppercase fw-bold" style="letter-spacing: 1px;">
                {{ site_name }}
            </p>
        </div>
    </section>

    <div class="row">
        <div class="col-md-8">
            <h2 class="mb-4">Dernières Actualités</h2>
            <div class="row">
                {% for article in last_articles %}
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h3 class="card-title h4">{{ article.title }}</h3>
                                <p class="text-muted small">{{ article.publishedAt|date('d/m/Y') }}</p>
                                <p class="card-text">{{ article.content|striptags|u.truncate(150, '...') }}</p>
                                <a href="{{ path('article_show', {id: article.id}) }}" class="btn btn-outline-dark btn-sm text-uppercase">Lire la suite</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-light border-start border-dark border-4">
                <h2 class="h3 mb-3">L'association</h2>
                <p>Présentez ici votre association : sa mission, ses valeurs et ses actions.</p>
                <a href="{{ path('special_page_show', {slug: 'association'}) }}" class="btn btn-dark w-100 text-uppercase">En savoir plus</a>
            </div>
        </div>
    </div>
{% endblock %}
