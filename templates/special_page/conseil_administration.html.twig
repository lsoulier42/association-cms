{% extends 'base.html.twig' %}

{% block title %}{{ specialPage.title }}{% endblock %}

{% import _self as macros %}

{# --- MACROS --- #}

{% macro member_card(title, icon_class, members, extra_classes = 'mb-4') %}
    <div class="card board-member-card {{ extra_classes }}">
        <div class="card-header py-3">
            <h5 class="text-primary m-0 fw-bold">
                <i class="{{ icon_class }} me-2"></i> {{ title }}
            </h5>
        </div>
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                {% for member in members %}
                    <li class="list-group-item px-3 py-2 member-item border-0 border-bottom">
                        <div>
                            <span class="d-block fw-bold text-dark" style="font-size: 0.95rem;">
                                {% if member.prefix %}{{ member.prefix.label }} {% endif %}{{ member.firstName }} {{ member.lastName }}
                            </span>
                            {% if member.title %}
                                <span class="text-muted small fw-semibold" style="font-size: 0.8rem;">{{ member.title.label }}</span>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endmacro %}

{% macro don_comite_card(title, icon_class, members) %}
    <div class="card board-member-card h-100 w-100">
        <div class="card-header py-2 px-2">
            <h6 class="text-primary m-0 fw-bold d-flex align-items-center" style="font-size: 0.85rem; min-height: 2.2rem; line-height: 1.2;">
                <i class="{{ icon_class }} me-2"></i> {{ title }}
            </h6>
        </div>
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                {% for member in members %}
                    <li class="list-group-item px-2 py-1 member-item border-0 border-bottom">
                        <span class="d-block small fw-bold text-dark" style="font-size: 0.8rem; word-break: break-word; white-space: normal; line-height: 1.2;">
                            {% if member.prefix %}{{ member.prefix.label }} {% endif %}{{ member.firstName }} {{ member.lastName }}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endmacro %}

{# --- STYLESHEETS --- #}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .board-member-card {
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            border-radius: 12px;
            overflow: hidden;
            background: #ffffff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(56, 58, 105, 0.08) !important;
        }
        .board-member-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(56, 58, 105, 0.1), 0 5px 15px rgba(0, 0, 0, 0.05);
        }
        .board-member-card .card-header {
            background: linear-gradient(135deg, rgba(56, 58, 105, 0.03) 0%, rgba(56, 58, 105, 0) 100%);
            border-bottom: 1px solid rgba(56, 58, 105, 0.08) !important;
        }
        .board-member-card .text-primary {
            color: var(--color-accent) !important;
        }
        .member-item {
            transition: background-color 0.2s ease;
        }
        .member-item:hover {
            background-color: rgba(56, 58, 105, 0.02) !important;
        }
        .member-item:last-child {
            border-bottom: 0 !important;
        }
    </style>
{% endblock %}

{# --- MAIN CONTENT --- #}

{% block main_content %}
    <article class="special-page py-4">
        <h1 class="mb-4 text-center fw-bold text-dark">{{ specialPage.title }}</h1>

        {% if specialPage.content %}
            <div class="special-page-content mb-5 mx-auto" style="max-width: 800px; text-align: justify;">
                {{ specialPage.content|raw }}
            </div>
        {% endif %}

        {% if boardMembers is defined and boardMembers is not empty %}
            {# Group members by category #}
            {% set members_by_category = {} %}
            {% for member in boardMembers %}
                {% set cat_val = member.category.value %}
                {% if members_by_category[cat_val] is not defined %}
                    {% set members_by_category = members_by_category|merge({(cat_val): []}) %}
                {% endif %}
                {% set members_by_category = members_by_category|merge({(cat_val): members_by_category[cat_val]|merge([member])}) %}
            {% endfor %}

            {# --- ROW 1: main board members (3 columns) --- #}
            <div class="row g-4 mb-5">
                {# Column 1: Vice-Presidents #}
                <div class="col-md-4 col-12 d-flex">
                    {% if members_by_category['VICE_PRESIDENTS'] is defined and members_by_category['VICE_PRESIDENTS'] is not empty %}
                        {{ macros.member_card('Vice-Présidents', 'fas fa-user-tie', members_by_category['VICE_PRESIDENTS'], 'w-100 h-100 mb-0') }}
                    {% else %}
                        <div class="card board-member-card bg-light border-0 w-100 h-100 py-4 text-center text-muted mb-0">
                            <i class="fas fa-user-tie fa-2x mb-2 opacity-50"></i>
                            <span>Aucun Vice-Président</span>
                        </div>
                    {% endif %}
                </div>

                {# Column 2: Bureau restreint (top) & Conseillers spéciaux (bottom) #}
                {% set has_bureau = members_by_category['BUREAU_RESTREINT'] is defined and members_by_category['BUREAU_RESTREINT'] is not empty %}
                {% set has_conseiller = members_by_category['CONSEILLER_SPECIAL'] is defined and members_by_category['CONSEILLER_SPECIAL'] is not empty %}
                <div class="col-md-4 col-12 d-flex flex-column">
                    {# Top: Bureau restreint #}
                    {% if has_bureau %}
                        {{ macros.member_card('Bureau Restreint', 'fas fa-shield-alt', members_by_category['BUREAU_RESTREINT'], 'w-100 flex-grow-1 ' ~ (has_conseiller ? 'mb-3' : 'mb-0')) }}
                    {% else %}
                        <div class="card board-member-card bg-light border-0 w-100 flex-grow-1 text-center text-muted py-4 {{ has_conseiller ? 'mb-3' : 'mb-0' }}">
                            <i class="fas fa-shield-alt fa-2x mb-2 opacity-50"></i>
                            <span>Aucun membre du Bureau</span>
                        </div>
                    {% endif %}

                    {# Bottom: Conseillers spéciaux #}
                    {% if has_conseiller %}
                        {{ macros.member_card('Conseillers Spéciaux', 'fas fa-lightbulb', members_by_category['CONSEILLER_SPECIAL'], 'w-100 flex-grow-1 mb-0') }}
                    {% endif %}
                </div>

                {# Column 3: Administrateurs #}
                <div class="col-md-4 col-12 d-flex">
                    {% if members_by_category['ADMINISTRATEUR'] is defined and members_by_category['ADMINISTRATEUR'] is not empty %}
                        {{ macros.member_card('Administrateurs', 'fas fa-users', members_by_category['ADMINISTRATEUR'], 'w-100 h-100 mb-0') }}
                    {% else %}
                        <div class="card board-member-card bg-light border-0 w-100 h-100 py-4 text-center text-muted mb-0">
                            <i class="fas fa-users fa-2x mb-2 opacity-50"></i>
                            <span>Aucun Administrateur</span>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# --- ROW 2: Dons and Comités (10 columns total, 5 for Dons and 5 for Comités) --- #}
            
            {# Extract Dons data #}
            {% set members_by_don = {} %}
            {% for member in boardMembers %}
                {% for don in member.dons %}
                    {% set don_val = don.value %}
                    {% if members_by_don[don_val] is not defined %}
                        {% set members_by_don = members_by_don|merge({(don_val): []}) %}
                    {% endif %}
                    {% set members_by_don = members_by_don|merge({(don_val): members_by_don[don_val]|merge([member])}) %}
                {% endfor %}
            {% endfor %}

            {% set don_types = [
                'EMBRYONS',
                'SPERMATOZOIDES',
                'OVOCYTES',
                'MITOCHONDRIES',
                'GESTATION'
            ] %}
            
            {% set don_icons = {
                'EMBRYONS': 'fas fa-egg',
                'SPERMATOZOIDES': 'fas fa-seedling',
                'OVOCYTES': 'fas fa-circle-notch',
                'MITOCHONDRIES': 'fas fa-atom',
                'GESTATION': 'fas fa-baby'
            } %}

            {# Extract Comités data #}
            {% set members_by_comite = {} %}
            {% for member in boardMembers %}
                {% for comite in member.comites %}
                    {% set comite_val = comite.value %}
                    {% if members_by_comite[comite_val] is not defined %}
                        {% set members_by_comite = members_by_comite|merge({(comite_val): []}) %}
                    {% endif %}
                    {% set members_by_comite = members_by_comite|merge({(comite_val): members_by_comite[comite_val]|merge([member])}) %}
                {% endfor %}
            {% endfor %}

            {% set comite_types = [
                'PRATIQUE',
                'INTERNATIONAL',
                'ETHIQUE',
                'PARENTALITE',
                'SCIENTIFIQUE'
            ] %}

            {% set comite_icons = {
                'PRATIQUE': 'fas fa-clipboard-list',
                'INTERNATIONAL': 'fas fa-globe',
                'ETHIQUE': 'fas fa-balance-scale',
                'PARENTALITE': 'fas fa-heart',
                'SCIENTIFIQUE': 'fas fa-flask'
            } %}

            <div class="row g-4">
                {# Left Half: Les Dons #}
                <div class="col-xl-6 col-12 d-flex flex-column">
                    <h4 class="mb-3 text-secondary border-bottom pb-2 fw-bold text-center text-sm-start">
                        <i class="fas fa-hand-holding-heart me-2"></i> Les Dons
                    </h4>
                    <div class="row row-cols-xl-5 row-cols-md-3 row-cols-sm-2 row-cols-1 g-2 flex-grow-1">
                        {% for type in don_types %}
                            <div class="col d-flex">
                                {% if members_by_don[type] is defined and members_by_don[type] is not empty %}
                                    {% set label = members_by_don[type][0].dons|filter(d => d.value == type)|first.label %}
                                    {{ macros.don_comite_card(label, don_icons[type], members_by_don[type]) }}
                                {% else %}
                                    <div class="card board-member-card h-100 w-100 bg-light border-0 py-3 text-center text-muted">
                                        <i class="{{ don_icons[type] }} mb-1 opacity-50"></i>
                                        <span class="small fw-semibold d-block text-truncate" title="{{ type|capitalize }}">{{ type|capitalize }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Right Half: Les Comités #}
                <div class="col-xl-6 col-12 d-flex flex-column">
                    <h4 class="mb-3 text-secondary border-bottom pb-2 fw-bold text-center text-sm-start">
                        <i class="fas fa-users-cog me-2"></i> Les Comités
                    </h4>
                    <div class="row row-cols-xl-5 row-cols-md-3 row-cols-sm-2 row-cols-1 g-2 flex-grow-1">
                        {% for type in comite_types %}
                            <div class="col d-flex">
                                {% if members_by_comite[type] is defined and members_by_comite[type] is not empty %}
                                    {% set label = members_by_comite[type][0].comites|filter(c => c.value == type)|first.label %}
                                    {{ macros.don_comite_card(label, comite_icons[type], members_by_comite[type]) }}
                                {% else %}
                                    <div class="card board-member-card h-100 w-100 bg-light border-0 py-3 text-center text-muted">
                                        <i class="{{ comite_icons[type] }} mb-1 opacity-50"></i>
                                        <span class="small fw-semibold d-block text-truncate" title="{{ type|capitalize }}">{{ type|capitalize }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

        {% else %}
            <p class="text-muted py-5 text-center">
                <i class="fas fa-users-slash fa-3x mb-3 d-block opacity-25"></i>
                Aucun membre n'est actuellement renseigné.
            </p>
        {% endif %}
    </article>
{% endblock %}
