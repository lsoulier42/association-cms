{% extends 'base.html.twig' %}

{% block title %}{{ specialPage.title }}{% endblock %}

{% block main_content %}
    <article class="special-page">
        <h1>{{ specialPage.title }}</h1>

        {% if specialPage.content %}
            <div class="special-page-content mb-5">
                {{ specialPage.content|raw }}
            </div>
        {% endif %}

        {% if specialPage.identifier == 'appointments' %}
            <div class="appointments mt-5">
                {% if appointments is defined and appointments is not empty %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 150px;">Date</th>
                                    <th style="width: 250px;">Organisme / Lieu</th>
                                    <th>Sujet</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for appointment in appointments %}
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="far fa-calendar-alt me-1 text-primary"></i>
                                                {{ appointment.date|date('d/m/Y') }}
                                            </span>
                                        </td>
                                        <td>
                                            <strong>{{ appointment.location }}</strong>
                                        </td>
                                        <td>
                                            {{ appointment.subject|nl2br }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted text-center py-5">
                        <i class="fas fa-calendar-times fa-3x mb-3 d-block opacity-25"></i>
                        Aucun rendez-vous prévu pour le moment.
                    </p>
                {% endif %}
            </div>
        {% endif %}

        {% if specialPage.identifier == 'press' %}
            <div class="press-mentions mt-5">
                {% if pressMentions is defined and pressMentions is not empty %}
                    <div class="row row-cols-1 row-cols-md-2 g-4">
                        {% for mention in pressMentions %}
                            <div class="col">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center mb-3">
                                            {% if mention.media and mention.media.logo %}
                                                <img src="{{ mention.media.logo }}" alt="{{ mention.media.name }}" class="me-3" style="max-height: 40px; max-width: 100px; object-fit: contain;">
                                            {% elseif mention.media %}
                                                <span class="badge bg-secondary me-3">{{ mention.media.name }}</span>
                                            {% endif %}
                                            <small class="text-muted ms-auto">
                                                {{ mention.publishedAt ? mention.publishedAt|date('d/m/Y') : mention.createdAt|date('d/m/Y') }}
                                            </small>
                                        </div>
                                        <h5 class="card-title">
                                            {% set type_colors = {
                                                'Article': 'primary',
                                                'Tribune': 'info',
                                                'Dépêche': 'secondary',
                                                'Interview': 'success',
                                                'Annonce': 'warning'
                                            } %}
                                            {% set badge_color = type_colors[mention.type] | default('primary') %}
                                            <span class="badge bg-{{ badge_color }} me-2" style="font-size: 0.6em; vertical-align: middle;">{{ mention.type }}</span>
                                            {{ mention.title }}
                                        </h5>

                                        <a href="{{ mention.externalLink }}" class="btn btn-outline-primary btn-sm mt-3" target="_blank" rel="noopener">
                                            Lire l'article
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted">Aucune mention presse pour le moment.</p>
                {% endif %}
            </div>
        {% endif %}

        {% if specialPage.identifier == 'partner' %}
            <div class="partners mt-5">
                {% if partners is defined and partners is not empty %}
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                        {% for partner in partners %}
                            <div class="col">
                                <div class="card h-100 shadow-sm border-0 text-center p-3">
                                    <div class="d-flex align-items-center justify-content-center mb-3" style="height: 80px;">
                                        {% if partner.logo %}
                                            <img src="{{ partner.logo }}" alt="{{ partner.title }}" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                                        {% else %}
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="fas fa-handshake fa-2x text-muted opacity-50"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="card-body p-0">
                                        <h5 class="card-title h6 mb-1">{{ partner.title }}</h5>
                                        {% if partner.subtitle %}
                                            <div class="small fw-bold text-primary mb-2" style="font-size: 0.8em; line-height: 1.2;">
                                                {{ partner.subtitle }}
                                            </div>
                                        {% endif %}
                                        {% if partner.description %}
                                            <div class="small text-muted mb-3">
                                                {{ partner.description|raw }}
                                            </div>
                                        {% endif %}
                                        {% if partner.websiteUrl %}
                                            <a href="{{ partner.websiteUrl }}" class="btn btn-sm btn-link text-decoration-none" target="_blank" rel="noopener">
                                                <i class="fas fa-external-link-alt me-1"></i> Site Web
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-muted text-center py-5">
                        Aucun partenaire pour le moment.
                    </p>
                {% endif %}
            </div>
        {% endif %}
    </article>
{% endblock %}
