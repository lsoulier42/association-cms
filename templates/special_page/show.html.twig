{% extends 'base.html.twig' %}

{% block title %}{{ specialPage.title }} | {{ site_name }}{% endblock %}

{% block main_content %}
    <article class="special-page">
        <h1>{{ specialPage.title }}</h1>

        {% if specialPage.content %}
            <div class="special-page-content mb-5">
                {{ specialPage.content|raw }}
            </div>
        {% endif %}

        {% block page_content %}{% endblock %}
    </article>
{% endblock %}
