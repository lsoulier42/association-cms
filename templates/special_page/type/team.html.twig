{% extends 'special_page/show.html.twig' %}

{% block page_content %}
    {% if teamMembers is defined and teamMembers is not empty %}
        <div class="team-members mt-4">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                {% for member in teamMembers %}
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 text-center p-3 team-member-card">
                            <div class="d-flex align-items-center justify-content-center mx-auto mb-3 rounded-circle overflow-hidden bg-light" style="width: 110px; height: 110px;">
                                {% if member.photo and member.photo.logo %}
                                    <img src="{{ member.photo.logo }}" alt="{{ member.fullName }}" class="w-100 h-100" style="object-fit: cover;">
                                {% else %}
                                    <i class="fa fa-user fa-3x text-muted opacity-25"></i>
                                {% endif %}
                            </div>
                            <div class="card-body p-0">
                                <h5 class="card-title h6 mb-1">{{ member.fullName }}</h5>
                                {% if member.role %}
                                    <div class="small fw-bold text-primary mb-2">{{ member.role }}</div>
                                {% endif %}
                                {% if member.bio %}
                                    <div class="small text-muted mb-2">{{ member.bio|nl2br }}</div>
                                {% endif %}
                                {% if member.email %}
                                    <a href="mailto:{{ member.email }}" class="btn btn-sm btn-link text-decoration-none">
                                        <i class="fa fa-envelope me-1"></i> Contacter
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <p class="text-muted text-center py-5">
            <i class="fa fa-users fa-3x mb-3 d-block opacity-25"></i>
            Aucun membre de l'équipe pour le moment.
        </p>
    {% endif %}
{% endblock %}
