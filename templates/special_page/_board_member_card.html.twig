<div class="col">
    <div class="card h-100 shadow-sm border-0">
        {% if member.photo and member.photo.logo %}
            <img src="{{ member.photo.logo }}" class="card-img-top" alt="Photo de {{ member.firstName }} {{ member.lastName }}" style="height: 250px; object-fit: cover;">
        {% else %}
            <div class="bg-light d-flex align-items-center justify-content-center card-img-top" style="height: 250px;">
                <i class="fas fa-user text-muted fa-4x opacity-25"></i>
            </div>
        {% endif %}
        <div class="card-body">
            <h5 class="card-title fw-bold text-dark">
                {% if member.prefix %}{{ member.prefix.label }} {% endif %}{{ member.firstName }} {{ member.lastName }}
            </h5>
            
            {% if member.title %}
                <h6 class="card-subtitle mb-3 text-primary fw-semibold">
                    {{ member.title.label }}
                </h6>
            {% endif %}

            {% if member.qualifications %}
                <p class="card-text small text-muted mt-3" style="white-space: pre-line; word-break: break-word;">
                    <i class="fa fa-graduation-cap me-1"></i> {{ member.qualifications }}
                </p>
            {% endif %}

            {% if member.expertise %}
                <div class="mb-3">
                    <span class="badge bg-secondary text-wrap text-start lh-base w-100 p-2">
                    <i class="fa fa-briefcase me-1"></i> Domaine d'expertise : {{ member.expertise|nl2br }}</span>
                </div>
            {% endif %}

            
        </div>
    </div>
</div>
